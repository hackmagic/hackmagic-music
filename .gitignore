# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# Stale source backups (e.g. src/gui/mod.rs.bak — kept out of the index on purpose)
**/*.rs.bak

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# JetBrains IDEs
.idea/

# AI assistant files
.trae/
.workbuddy/
.anchored_summary.md

# OpenCode
.opencode/

# Local config
.atomcode/
.uploads/

# OS files
.DS_Store
Thumbs.db

# Test artifacts
test_*.bat
test_*.sh
test_*.py
test_*.wav
hm_gui_pid.txt

# vecdb local JSON storage (per-user, regenerated)
config/library.json
library.json
start.bat

# Audio assets (too large for git)
assets/*.flac
assets/*.mp3
assets/*.wav
assets/*.ogg

# Screenshots
原播放器界面截图/

# Models and vector DB data
models/
vecdb/

# Electron
node_modules
gui/node_modules
gui/dist-electron
gui/dist

# Tauri generated schemas (can be regenerated)
gui/src-tauri/gen

# AI UI test runtime artifacts (regenerated on each run)
hm_e2e_report.json
hm_screenshot_report.json
screenshots/

# Runtime logs & pid files (written into CWD by hm-gui / CLI runs)
hm_gui.log
hm_panic.log
hm_stderr*.log
hm_stdout*.log
hm_gui_pid.txt

{
  "productName": "HackMagic Music Player",
  "version": "1.0.0",
  "identifier": "com.hm.player",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:10280",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "HackMagic Music Player",
        "width": 960,
        "height": 680,
        "minWidth": 760,
        "minHeight": 480,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:10280 ws://127.0.0.1:10280; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "targets": "all",
    "externalBin": [],
    "windows": {
      "wix": {
        "language": "zh-CN",
        "template": "main.wxs"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}